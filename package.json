{
  "name": "student-course-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "server": "json-server --watch db.json --port 3001",
    "client": "vite",
    "dev": "concurrently -k -n API,UI -c blue,green \"npm:server\" \"npm:client\"",
    "build": "vite build"
  },
  "dependencies": {
    "bootstrap": "5.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "8.2.2",
    "json-server": "0.17.4",
    "vite": "5.4.8"
  }
}
